<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<title>{{ headline_plain or headline }}</title>
<style>{{ css | safe }}</style>
</head>
<body>
<section class="page">

  {# === HERO: 좌측 타이틀 + 우측 제품 이미지 === #}
  <header class="hero">
    <div class="hero__left">
      <div class="hero__eyebrow">{{ company.name }}<span>Case Study</span></div>
      <h1 class="hero__title">{{ headline }}</h1>
      {% if subhead %}<p class="hero__sub">{{ subhead }}</p>{% endif %}
      <hr class="hero__rule">

      {# === 헤더 메타 — 집행 기간(월) + 집행 매체 2개만, 세로 정렬 === #}
      {% set hm = header_meta or {} %}
      {% if hm.period_month or hm.media_products %}
      <div class="hero__meta">
        {% if hm.period_month %}
        <span class="hero__meta__item">
          <span class="hero__meta__label">집행 기간</span>
          <span class="hero__meta__value">{{ hm.period_month }}</span>
        </span>
        {% endif %}
        {% if hm.media_products %}
        <span class="hero__meta__item">
          <span class="hero__meta__label">집행 매체</span>
          <span class="hero__meta__value">{{ hm.media_products }}</span>
        </span>
        {% endif %}
      </div>
      {% endif %}
    </div>

    {# 제품 이미지 — Gemini 생성 또는 placeholder #}
    {% if hero_image_url %}
    <div class="hero__img" style="background-image:url('{{ hero_image_url }}'); background-size:cover; background-position:center;"></div>
    {% else %}
    <div class="hero__img hero__img--placeholder" aria-label="product image placeholder"></div>
    {% endif %}
  </header>

  {# === BODY: 좌(요약+01,02,03) / 우(04 표 + 05 인사이트) === #}
  <div class="body">

    {# --- LEFT --- #}
    <div class="body__left">

      {% if narrative.summary %}
      <div class="summary">
        <h3>요약</h3>
        <p>{{ narrative.summary }}</p>
      </div>
      {% endif %}

      {# 블록 렌더 규칙:
         - 기본: 한 항목 = <p> 단락
         - '- ' / '* ' / '▪ ' / '• ' 로 시작한 줄 = 불릿
         - 연속된 불릿은 한 <ul> 로 자동 그룹화
         html_renderer._to_blocks 가 미리 그룹화해서 {kind, ...} 로 넘김.
         Defensive: 비정상 경로 (옛 빌드) 에서 b 가 dict 아닐 수도 있어
         is mapping 검사 후 fallback. #}
      {% macro sec(num, title, blocks) %}
        <h2 class="sec"><span class="num">{{ num }}.</span>{{ title }}</h2>
        {% if blocks is string %}
          {% if blocks %}<p>{{ blocks }}</p>{% endif %}
        {% elif blocks %}
          {% for b in blocks %}
            {% if b is mapping and b.get('kind') == 'ul' %}
              <ul class="bul">
                {% for it in b.get('items', []) %}<li>{{ it }}</li>{% endfor %}
              </ul>
            {% elif b is mapping and b.get('kind') == 'spacer' %}
              <div class="block-spacer"></div>
            {% elif b is mapping %}
              <p>{{ b.get('text', '') }}</p>
            {% else %}
              <p>{{ b }}</p>
            {% endif %}
          {% endfor %}
        {% endif %}
      {% endmacro %}

      {{ sec('01', '캠페인 목적',    narrative.overview)   }}
      {{ sec('02', '광고 집행 배경', narrative.background) }}
      <h2 class="sec"><span class="num">03.</span>적용 전략</h2>
      {% if narrative.strategy is string %}
        {% if narrative.strategy %}<p>{{ narrative.strategy }}</p>{% endif %}
      {% elif narrative.strategy %}
        {% for b in narrative.strategy %}
          {% if b is mapping and b.get('kind') == 'ul' %}
            <ul class="bul">
              {% for it in b.get('items', []) %}<li>{{ it }}</li>{% endfor %}
            </ul>
          {% elif b is mapping and b.get('kind') == 'spacer' %}
            <div class="block-spacer"></div>
          {% elif b is mapping %}
            <p>{{ b.get('text', '') }}</p>
          {% else %}
            <p>{{ b }}</p>
          {% endif %}
        {% endfor %}
      {% endif %}

    </div>

    {# --- RIGHT --- #}
    <div class="body__right">

      {% if campaign.metrics_table %}
      <div class="metrics-wrap">
        <h2 class="sec sec--right"><span class="num">04.</span>캠페인 성과</h2>
        <table class="metrics">
          <thead>
            <tr><th style="width:38%">성과 지표</th><th style="width:24%">수치</th><th>비고</th></tr>
          </thead>
          <tbody>
            {# 8 row cap — 그 이상이면 1page 넘침 위험. 편집 모드의 '표' 체크박스 OFF 로 조절.
               '강조' (m.highlight) 가 켜진 행만 coral. 0개면 강조 없음. #}
            {% for m in campaign.metrics_table[:8] %}
            <tr>
              <td class="ind">{{ m.indicator }}</td>
              <td class="val{% if m.highlight %} warm{% endif %}">{{ m.value }}</td>
              <td class="note">{{ m.note }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
        {% if metrics_footnotes_lines %}
        <div class="metrics-footnotes">
          {% for line in metrics_footnotes_lines %}
          <div class="fn-line">{{ line }}</div>
          {% endfor %}
        </div>
        {% endif %}
      </div>
      {% endif %}

      {% if narrative.insights %}
        {# 빈 항목 = 사용자가 입력한 spacer. 비-빈 인사이트만 카운트해서 단일이면 paragraph. #}
        {% set _real_insights = narrative.insights | reject('equalto', '') | list %}
        {% if _real_insights %}
        <div class="insights">
          <h2>05. 인사이트</h2>
          {% if _real_insights | length == 1 %}
            <p>{{ _real_insights[0] }}</p>
          {% else %}
            <ul>
              {% for item in narrative.insights %}
                {% if item %}
                  <li>{{ item }}</li>
                {% else %}
                  <li class="spacer"></li>
                {% endif %}
              {% endfor %}
            </ul>
          {% endif %}
        </div>
        {% endif %}
      {% endif %}

    </div>
  </div>

  {# === FOOTER === #}
  <footer class="ftr">
    <div class="ftr__about">
      <strong>About {{ company.name }}</strong>
      <p>{{ company.description }}</p>
    </div>
    <div class="ftr__meta">
      <div>
        <a href="{{ company.url }}">{{ company.url }}</a>
        {% if company.url_secondary %} · <a href="{{ company.url_secondary }}">{{ company.url_secondary }}</a>{% endif %}
      </div>
      <div><a href="mailto:{{ company.press_contact_email }}">{{ company.press_contact_email }}</a></div>
      <div>© {{ year }} {{ company.name }} Inc.</div>
    </div>
  </footer>

</section>
</body>
</html>
